# Read-only Postgres role on the Neon warehouse. Never commit the real value.
NEON_READONLY_URL=

# Free API key from https://console.groq.com (no credit card required)
GROQ_API_KEY=

# Groq model used for NL->SQL. llama-3.3-70b-versatile was shut down on 2026-08-16.
GROQ_MODEL=openai/gpt-oss-120b

# Shared secret required to read /api/diagnostics. Leave empty to disable the route.
DIAGNOSTICS_TOKEN=
